# ---------- 数据库 ----------
DATABASE_URL="postgresql+asyncpg://user:password@127.0.0.1:5432/dbname"
POSTGRES_USER=myerp
POSTGRES_PASSWORD=changeme
POSTGRES_DB=myerp

# ---------- 雪花 ID ----------
SNOWFLAKE_INSTANCE=0
SNOWFLAKE_SEQ=0
SNOWFLAKE_EPOCH=1735689600000

# ---------- JWT ----------
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_ISSUER=hsh

# ---------- 腾讯云 COS ----------
COS_REGION=ap-guangzhou
COS_BUCKET=your-bucket-name
COS_SECRET_ID=AKIDxxxxxxxxxxxxxxxx
COS_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
COS_SCHEME=https
COS_UPLOAD_PREFIX=drawings/
COS_PRESIGN_EXPIRE=900
COS_MAX_FILE_SIZE=104857600
COS_ALLOWED_TYPES=pdf,step,dwg,dxf

# ---------- 时区 ----------
TZ=Asia/Shanghai
SHELF_SEED_ON_MIGRATE=true

# ---------- 腾讯云容器镜像仓库（用于本地 push 脚本） ----------
# 去 https://console.cloud.tencent.com/tcr 的「访问凭证」创建固定密码
DOCKER_USERNAME=your-tcr-username
DOCKER_PASSWORD=your-tcr-password
DOCKER_REPO=ccr.ccs.tencentyun.com/hsh-erp

# ---------- 单次请求体上限（2026-07-22 新增；与 nginx client_max_body_size 对齐）----------
# 默认 300 MB；批量 PDF 上传 POST /parts/batch-with-pdfs 配套使用。
MAX_REQUEST_BODY_SIZE=314572800
