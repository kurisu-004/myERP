# ============================================================================
# myERP 生产环境配置模板
# 用法:
#   1. cp .env.production.example .env.production
#   2. 把所有 <CHANGE_ME> 改成实际值
#   3. 在 CVM 上: docker compose --env-file .env.production up -d
# ============================================================================

# ---------- 镜像来源（先在本地 ./scripts/push-images.sh 推到 TCR）----------
DOCKER_REPO=ccr.ccs.tencentyun.com/hsh-erp
IMAGE_TAG=latest

# CVM 部署时需要先 docker login（脚本会提示）：
#   docker login ccr.ccs.tencentyun.com
# 也可以在 .env 里加 DOCKER_USERNAME / DOCKER_PASSWORD 备用（不推荐）

# ---------- 宿主机端口映射 ----------
FRONTEND_PORT=80

# ---------- 时区 ----------
TZ=Asia/Shanghai

# ============================================================================
# Postgres（被 docker-compose 读，传给 postgres + backend）
# ============================================================================
POSTGRES_USER=myerp
POSTGRES_PASSWORD=<CHANGE_ME-strong-password>
POSTGRES_DB=myerp

# ============================================================================
# 雪花 ID
# ============================================================================
SNOWFLAKE_INSTANCE=0
SNOWFLAKE_SEQ=0
SNOWFLAKE_EPOCH=1735689600000

# ============================================================================
# JWT（生产环境务必换成 32+ 字节随机串）
# 生成: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ============================================================================
JWT_SECRET=<CHANGE_ME-32+bytes-random>
JWT_ALGORITHM=HS256
JWT_ISSUER=hsh
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=2880

# ============================================================================
# 腾讯云 COS（图纸存储；后端用长期 SecretId/Key 调 SDK）
# ============================================================================
COS_REGION=ap-guangzhou
COS_BUCKET=<CHANGE_ME-your-bucket>
COS_SECRET_ID=<CHANGE_ME-AKIDxxxxxxxx>
COS_SECRET_KEY=<CHANGE_ME-secret-key>
COS_SCHEME=https
COS_ENDPOINT=
COS_UPLOAD_PREFIX=drawings/
COS_PRESIGN_EXPIRE=900
COS_MAX_FILE_SIZE=104857600
COS_ALLOWED_TYPES=pdf,step,dwg,dxf

# ============================================================================
# 首次启动自动 seed 货架 / 默认账号（生产可关）
# ============================================================================
SHELF_SEED_ON_MIGRATE=true
