# ============================================================================
# myERP 测试服务器环境变量模板
# 用法:
#   1. cp .env.staging.example .env.staging
#   2. 填实际密钥（POSTGRES_PASSWORD / JWT_SECRET / COS_* / DOCKER_*）
#   3. docker compose -f docker-compose.staging.yml --env-file .env.staging up -d
#
# ⚠️ 此文件含敏感凭据；权限: chmod 600 .env.staging
#    不会被 commit 到 git（.gitignore 已过滤 .env.*；本文件走 !.env.staging.example
#    例外规则入仓作为模板）。
#
# 与 .env.example / .env.production 的区别：
#   - POSTGRES_USER/PASSWORD/DB 默认值是 staging 独立的（hsh_staging / test_change_me）
#   - NGINX_SERVER_NAME 默认 _，NGINX_REDIRECT_TARGET 默认空（让 nginx 模板走 HTTP 通配）
#   - 不暴露 FRONTEND_HTTPS_PORT（测试服务器只 :80）
# ============================================================================

# ---------- 镜像来源（先在本地 ./scripts/push-images.sh 推到 TCR；测试服务器 docker login 后 pull）----------
DOCKER_REPO=ccr.ccs.tencentyun.com/hsh-erp
IMAGE_TAG=latest
# ↓↓↓ 凭据若 CVM 上已经 docker login TCR 可保留空；deploy.sh 会回退到 .env 这俩。
DOCKER_USERNAME=
DOCKER_PASSWORD=

# ---------- 宿主机端口映射 ----------
# 测试服务器只暴露 :80；不暴露 443（无证书）
FRONTEND_PORT=80
# 测试服务器上可暴露 postgres 5432 供本地 psql 调试；不需要时留空或注释
POSTGRES_PORT=5432

# ---------- 时区 ----------
TZ=Asia/Shanghai

# ============================================================================
# Postgres（独立于生产；运行在测试服务器本机 bind mount ./data/postgres-staging）
# ============================================================================
POSTGRES_USER=hsh_staging
POSTGRES_PASSWORD=test_change_me
POSTGRES_DB=hsh_staging

# ============================================================================
# 雪花 ID（与生产同源即可；测试服务器一般只用 1 个 worker，INSTANCE=SEQ=0）
# ============================================================================
SNOWFLAKE_INSTANCE=0
SNOWFLAKE_SEQ=0
SNOWFLAKE_EPOCH=1735689600000

# ============================================================================
# JWT（与生产必须不同值；推荐 secrets.token_urlsafe(48) 生成）
# ============================================================================
JWT_SECRET=staging-change-me-please-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ISSUER=hsh
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=2880
# 2026-07-10 接入双 token：access 12h/48h，refresh 7d 轮转。
# 测试服务器可缩短 refresh TTL；不要低于 1440（24h）。
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ============================================================================
# 腾讯云 COS
#   - 可与生产共用 bucket（图纸 / G 代码共用一套文件存储），也可独立 bucket
#   - SECRET_ID/KEY 强烈建议使用子账号密钥（限制 IP），不要沿用生产主密钥
# ============================================================================
COS_REGION=ap-guangzhou
COS_BUCKET=erp-drawing-1410882329
COS_SECRET_ID=AKIDxxxxxxxxxxxxxxxx
COS_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
COS_SCHEME=https
COS_ENDPOINT=
COS_UPLOAD_PREFIX=hsh-erp-staging/
COS_PRESIGN_EXPIRE=900
COS_MAX_FILE_SIZE=104857600
# 白名单必须含图纸类 + CNC G 代码类（CNC 编程员上传走同一 COS SDK）。
# pdf/step/stp/dwg/dxf 图纸；nc/tap/cnc/mpf/ngc G 代码。缺一个会让上传 400。
COS_ALLOWED_TYPES=pdf,step,stp,dwg,dxf,nc,tap,cnc,mpf,ngc

# ============================================================================
# nginx 模板占位符（关键：覆盖生产默认值，让测试服务器走 HTTP 通配无 301）
# 详见 frontend/nginx.http-only.conf + frontend/entrypoint.sh 的 envsubst 渲染。
# ============================================================================
NGINX_SERVER_NAME=_
NGINX_REDIRECT_TARGET=
# 测试场景下不会真挂证书；只是给 entrypoint 一个不会被读取的占位文件名
SSL_CRT_FILENAME=staging-dummy.crt
SSL_KEY_FILENAME=staging-dummy.key

# ============================================================================
# 首次启动自动 seed 货架 / 默认账号（测试建议开，生产可关）
# ============================================================================
SHELF_SEED_ON_MIGRATE=true

# ============================================================================
# 单次请求体上限（与 frontend/nginx.conf 的 client_max_body_size 对齐）
# ============================================================================
MAX_REQUEST_BODY_SIZE=314572800

# ============================================================================
# CPU 核心数（与生产可不同；测试服务器一般 2-4 核）
# ============================================================================
APP_CPU_CORES=4
